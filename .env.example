
# Платформа lk.macmagia.ru — выдача доступа к колодам после оплаты.
# Письмо с логином и паролем шлёт САМА платформа, SMTP здесь больше не нужен.
# PROVISION_SECRET ДОЛЖЕН совпадать с одноимённой переменной в .env платформы.
LK_PROVISION_URL=https://lk.macmagia.ru/api/provision
PROVISION_SECRET=
# Тариф колод на платформе (курс у каждой свой: deck-<id товара>).
LK_PLAN_SLUG=bazovyy
LK_PROVISION_MAX_ATTEMPTS=3
LK_PROVISION_RETRY_DELAY_MS=3000
